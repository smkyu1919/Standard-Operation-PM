# ============================================================
# ============================================================
# ============================================================
#    SSM Run Command 전용 커널 패치 동작과정
# SSM 실행 권한이 root인지 확인합니다.
# /etc/os-release에서 OS 종류와 버전을 확인합니다.
# 현재 실행 중인 커널을 확인합니다.
# /와 /boot의 여유 공간을 확인합니다.
# 패치 전 설치된 커널 목록을 저장합니다.
# 현재 커널을 소유한 패키지 또는 커널 메타 패키지를 찾습니다.
# Ubuntu에서 GA/HWE 등 여러 커널 계열이 혼재하면 오류로 중단합니다.
# 캐시를 삭제하기 전에 저장소 접근 가능 여부를 확인합니다.
# 패키지 캐시를 정리하고 저장소 메타데이터를 갱신합니다.
# OS별 패키지 관리자로 현재 커널 계열만 업데이트합니다.
# 패치 전후 커널 목록을 비교해 신규 커널 설치 여부를 확인합니다.
# 신규 커널이 없으면 성공으로 종료하고 재부팅하지 않습니다.
# 신규 커널이 있으면 성공 결과를 출력하고 1분 후 재부팅합니다.
# 중간에 실패하면 오류 로그를 출력하고 재부팅하지 않습니다.
# ============================================================
# ============================================================
# ============================================================




#!/bin/sh

# ============================================================
# 0. 정책 설정
# ============================================================
MIN_ROOT_FREE_MB=1024
MIN_BOOT_FREE_MB=200

# AL2023은 운영 적용 전 검증한 릴리스 버전 지정 권장
# 예: AL2023_RELEASEVER="2023.12.20260611"
# 빈 값이면 현재 인스턴스에 설정된 저장소 버전 사용
AL2023_RELEASEVER=""

REBOOT_DELAY_MINUTES=1

WORK_DIR="/tmp/kernel-patch-$$"
COMMAND_LOG="${WORK_DIR}/command.log"
KERNEL_BEFORE_FILE="${WORK_DIR}/kernel-before"
KERNEL_AFTER_FILE="${WORK_DIR}/kernel-after"
KERNEL_NEW_FILE="${WORK_DIR}/kernel-new"
APT_CANDIDATES_FILE="${WORK_DIR}/apt-kernel-candidates"
APT_SELECTED_FILE="${WORK_DIR}/apt-kernel-selected"
PATCH_EXECUTED=0

# ============================================================
# 1. 공통 함수
# ============================================================
cleanup()
{
    if [ -d "${WORK_DIR}" ]; then
        rm -f "${COMMAND_LOG}" "${KERNEL_BEFORE_FILE}" \
            "${KERNEL_AFTER_FILE}" "${KERNEL_NEW_FILE}" \
            "${APT_CANDIDATES_FILE}" "${APT_SELECTED_FILE}" 2>/dev/null
        rmdir "${WORK_DIR}" 2>/dev/null
    fi
}

fail()
{
    ERROR_MESSAGE="$1"
    ERROR_CODE="${2:-1}"

    echo "============================================================"
    echo "[ERROR] ${ERROR_MESSAGE}"
    echo "============================================================"

    cleanup
    exit "${ERROR_CODE}"
}

run_step()
{
    STEP_NAME="$1"
    shift

    echo "[RUN] ${STEP_NAME}"
    : > "${COMMAND_LOG}"

    "$@" >"${COMMAND_LOG}" 2>&1
    RESULT=$?

    if [ "${RESULT}" -ne 0 ]; then
        echo "-------------------- ERROR LOG ---------------------"
        tail -n 30 "${COMMAND_LOG}" 2>/dev/null
        echo "----------------------------------------------------"
        fail "${STEP_NAME} 실패, exit_code=${RESULT}"
    fi

    echo "[OK] ${STEP_NAME}"
}

run_zypper_step()
{
    STEP_NAME="$1"
    shift

    echo "[RUN] ${STEP_NAME}"
    : > "${COMMAND_LOG}"

    "$@" >"${COMMAND_LOG}" 2>&1
    RESULT=$?

    case "${RESULT}" in
        0|102|103)
            echo "[OK] ${STEP_NAME}"
            ;;
        *)
            echo "-------------------- ERROR LOG ---------------------"
            tail -n 30 "${COMMAND_LOG}" 2>/dev/null
            echo "----------------------------------------------------"
            fail "${STEP_NAME} 실패, exit_code=${RESULT}"
            ;;
    esac
}

check_command()
{
    COMMAND_NAME="$1"
    command -v "${COMMAND_NAME}" >/dev/null 2>&1 ||
        fail "${COMMAND_NAME} 명령어 확인 불가"
}

check_free_space()
{
    TARGET_PATH="$1"
    REQUIRED_MB="$2"
    FREE_MB="$(df -Pm "${TARGET_PATH}" 2>/dev/null | awk 'NR == 2 {print $4}')"

    case "${FREE_MB}" in
        ''|*[!0-9]*) fail "${TARGET_PATH} 여유 공간 확인 실패" ;;
    esac

    if [ "${FREE_MB}" -lt "${REQUIRED_MB}" ]; then
        fail "${TARGET_PATH} 여유 공간 부족: ${FREE_MB}MB, 필요=${REQUIRED_MB}MB"
    fi
}

save_kernel_inventory()
{
    OUTPUT_FILE="$1"
    : > "${OUTPUT_FILE}"

    for KERNEL_FILE in /boot/vmlinuz-*; do
        [ -f "${KERNEL_FILE}" ] || continue
        basename "${KERNEL_FILE}" | sed 's/^vmlinuz-//' >> "${OUTPUT_FILE}"
    done

    # comm 비교를 위해 일반 문자 정렬 사용
    sort -u "${OUTPUT_FILE}" -o "${OUTPUT_FILE}"

    [ -s "${OUTPUT_FILE}" ] ||
        fail "/boot에서 설치된 커널을 확인할 수 없음"
}

detect_rpm_kernel_package()
{
    CURRENT_VMLINUZ="/boot/vmlinuz-${CURRENT_KERNEL}"

    [ -f "${CURRENT_VMLINUZ}" ] ||
        fail "현재 커널 파일 확인 불가: ${CURRENT_VMLINUZ}"

    RPM_OWNER="$(
        rpm -qf "${CURRENT_VMLINUZ}" --qf '%{NAME}\n' 2>/dev/null |
        head -n 1
    )"

    [ -n "${RPM_OWNER}" ] ||
        fail "현재 커널의 RPM 패키지 확인 실패"

    RPM_BASE_PACKAGE="$(printf '%s\n' "${RPM_OWNER}" | sed 's/-core$//')"

    if rpm -q "${RPM_BASE_PACKAGE}" >/dev/null 2>&1; then
        KERNEL_PACKAGE="${RPM_BASE_PACKAGE}"
    else
        KERNEL_PACKAGE="${RPM_OWNER}"
    fi

    [ -n "${KERNEL_PACKAGE}" ] ||
        fail "업데이트할 RPM 커널 패키지 판별 실패"
}

detect_apt_kernel_packages()
{
    CURRENT_FLAVOR="$(printf '%s\n' "${CURRENT_KERNEL}" | awk -F- '{print $NF}')"
    APT_KERNEL_PACKAGES=""

    dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' \
        'linux-*' 2>/dev/null |
    awk '$1 ~ /^ii/ {
        package=$2
        sub(/:.*$/, "", package)
        print package
    }' |
    while IFS= read -r PACKAGE; do
        case "${PACKAGE}" in
            linux-aws|linux-aws-*|\
            linux-generic|linux-generic-*|\
            linux-virtual|linux-virtual-*|\
            linux-kvm|linux-kvm-*|\
            linux-azure|linux-azure-*|\
            linux-gcp|linux-gcp-*|\
            linux-oracle|linux-oracle-*|\
            linux-image-amd64|linux-image-cloud-amd64|\
            linux-image-arm64|linux-image-cloud-arm64)
                if apt-cache depends "${PACKAGE}" 2>/dev/null |
                    grep -E 'Depends:.*linux-(image|signed-image)' >/dev/null 2>&1
                then
                    printf '%s\n' "${PACKAGE}"
                fi
                ;;
        esac
    done > "${APT_CANDIDATES_FILE}"

    if [ ! -s "${APT_CANDIDATES_FILE}" ]; then
        fail "설치된 APT 커널 메타 패키지 확인 실패"
    fi

    : > "${APT_SELECTED_FILE}"

    if [ -n "${CURRENT_FLAVOR}" ]; then
        grep -E "^linux-${CURRENT_FLAVOR}($|-)" \
            "${APT_CANDIDATES_FILE}" \
            > "${APT_SELECTED_FILE}" 2>/dev/null || true
    fi

    # Debian처럼 커널명 suffix와 메타 패키지명이 다른 경우
    if [ ! -s "${APT_SELECTED_FILE}" ]; then
        cp "${APT_CANDIDATES_FILE}" "${APT_SELECTED_FILE}"
    fi

    # generic GA와 HWE가 함께 설치된 경우 자동 선택 금지
    if grep -qx 'linux-generic' "${APT_SELECTED_FILE}" &&
       grep -E '^linux-generic-hwe-' "${APT_SELECTED_FILE}" >/dev/null 2>&1
    then
        fail "Ubuntu generic GA/HWE 커널 계열이 함께 설치됨, 자동 패치 제외 필요"
    fi

    # 기본 클라우드 메타 패키지가 있으면 해당 패키지를 우선 선택
    if grep -qx "linux-${CURRENT_FLAVOR}" "${APT_SELECTED_FILE}" 2>/dev/null; then
        printf '%s\n' "linux-${CURRENT_FLAVOR}" > "${APT_SELECTED_FILE}"
    fi

    APT_PACKAGE_COUNT="$(
        awk 'NF {count++} END {print count+0}' "${APT_SELECTED_FILE}"
    )"

    if [ "${APT_PACKAGE_COUNT}" -gt 1 ]; then
        echo "[INFO] APT KERNEL CANDIDATES:"
        sed 's/^/[INFO]   - /' "${APT_SELECTED_FILE}"
        fail "현재 커널에 대응하는 메타 패키지가 여러 개 확인됨"
    fi

    APT_KERNEL_PACKAGES="$(
        tr '\n' ' ' < "${APT_SELECTED_FILE}" |
        sed 's/[[:space:]]*$//'
    )"

    [ -n "${APT_KERNEL_PACKAGES}" ] ||
        fail "현재 커널에 대응하는 APT 커널 메타 패키지 확인 실패"
}

# ============================================================
# 2. 실행 환경 확인
# ============================================================
umask 077

if ! mkdir "${WORK_DIR}" 2>/dev/null; then
    echo "============================================================"
    echo "[ERROR] 임시 작업 경로 생성 실패: ${WORK_DIR}"
    echo "============================================================"
    exit 1
fi

trap 'cleanup' 0
trap 'fail "작업 중 인터럽트 또는 종료 신호 발생" 90' 1 2 15

[ "$(id -u)" -eq 0 ] || fail "root 권한 필요"
[ -r /etc/os-release ] || fail "/etc/os-release 확인 불가"

for REQUIRED_COMMAND in uname df awk sed sort tail grep tr comm basename; do
    check_command "${REQUIRED_COMMAND}"
done

# ============================================================
# 3. OS 및 현재 커널 확인
# ============================================================
. /etc/os-release

OS_ID="${ID:-unknown}"
OS_VERSION="${VERSION_ID:-unknown}"
OS_MAJOR="${OS_VERSION%%.*}"
CURRENT_KERNEL="$(uname -r 2>/dev/null)"

if [ "${OS_ID}" = "unknown" ] ||
   [ "${OS_VERSION}" = "unknown" ] ||
   [ -z "${CURRENT_KERNEL}" ]; then
    fail "OS 또는 현재 커널 정보 확인 실패"
fi

case "${OS_ID}" in
    amzn)
        case "${OS_MAJOR}" in
            2) COMMAND_GROUP="AMAZON_LINUX_2" ;;
            2023) COMMAND_GROUP="AMAZON_LINUX_2023" ;;
            *) fail "지원하지 않는 Amazon Linux 버전: ${OS_VERSION}" ;;
        esac
        ;;
    rhel)
        case "${OS_MAJOR}" in
            6|7|8|9|10) COMMAND_GROUP="RHEL_${OS_MAJOR}" ;;
            *) fail "지원하지 않는 RHEL 버전: ${OS_VERSION}" ;;
        esac
        ;;
    centos)
        case "${OS_MAJOR}" in
            6|7|8|9) COMMAND_GROUP="CENTOS_${OS_MAJOR}" ;;
            *) fail "지원하지 않는 CentOS 버전: ${OS_VERSION}" ;;
        esac
        ;;
    rocky)
        case "${OS_MAJOR}" in
            8|9|10) COMMAND_GROUP="ROCKY_LINUX_${OS_MAJOR}" ;;
            *) fail "지원하지 않는 Rocky Linux 버전: ${OS_VERSION}" ;;
        esac
        ;;
    almalinux)
        case "${OS_MAJOR}" in
            8|9|10) COMMAND_GROUP="ALMALINUX_${OS_MAJOR}" ;;
            *) fail "지원하지 않는 AlmaLinux 버전: ${OS_VERSION}" ;;
        esac
        ;;
    ol)
        case "${OS_MAJOR}" in
            6|7|8|9|10) COMMAND_GROUP="ORACLE_LINUX_${OS_MAJOR}" ;;
            *) fail "지원하지 않는 Oracle Linux 버전: ${OS_VERSION}" ;;
        esac
        ;;
    ubuntu) COMMAND_GROUP="UBUNTU_${OS_MAJOR}" ;;
    debian) COMMAND_GROUP="DEBIAN_${OS_MAJOR}" ;;
    sles) COMMAND_GROUP="SLES_${OS_MAJOR}" ;;
    opensuse-leap) COMMAND_GROUP="OPENSUSE_LEAP_${OS_MAJOR}" ;;
    opensuse-tumbleweed) COMMAND_GROUP="OPENSUSE_TUMBLEWEED" ;;
    fedora) COMMAND_GROUP="FEDORA_${OS_MAJOR}" ;;
    *) fail "지원하지 않는 OS: ${OS_ID} ${OS_VERSION}" ;;
esac

echo "============================================================"
echo "[INFO] KERNEL PATCH START"
echo "[INFO] OS              : (${OS_ID} ${OS_VERSION})"
echo "[INFO] CURRENT KERNEL  : ${CURRENT_KERNEL}"
echo "[INFO] COMMAND GROUP   : ${COMMAND_GROUP}"
echo "============================================================"

# ============================================================
# 4. 디스크 및 현재 커널 상태 확인
# ============================================================
check_free_space "/" "${MIN_ROOT_FREE_MB}"
[ -d /boot ] && check_free_space "/boot" "${MIN_BOOT_FREE_MB}"
save_kernel_inventory "${KERNEL_BEFORE_FILE}"

# ============================================================
# 5. YUM 계열
# ============================================================
case "${COMMAND_GROUP}" in
    AMAZON_LINUX_2|RHEL_6|RHEL_7|CENTOS_6|CENTOS_7|\
    ORACLE_LINUX_6|ORACLE_LINUX_7)
        check_command yum
        check_command rpm
        detect_rpm_kernel_package

        echo "[INFO] TARGET PACKAGE : ${KERNEL_PACKAGE}"

        run_step "YUM 저장소 사전 확인" yum -y makecache
        run_step "YUM 캐시 정리" yum clean all
        run_step "YUM 메타데이터 재생성" yum -y makecache
        run_step "커널 업데이트" yum -y update "${KERNEL_PACKAGE}"

        PATCH_EXECUTED=1
        ;;
esac

# ============================================================
# 6. DNF 계열
# ============================================================
case "${COMMAND_GROUP}" in
    AMAZON_LINUX_2023|RHEL_8|RHEL_9|RHEL_10|CENTOS_8|CENTOS_9|\
    ROCKY_LINUX_*|ALMALINUX_*|ORACLE_LINUX_8|ORACLE_LINUX_9|\
    ORACLE_LINUX_10|FEDORA_*)
        check_command dnf
        check_command rpm
        detect_rpm_kernel_package

        echo "[INFO] TARGET PACKAGE : ${KERNEL_PACKAGE}"

        if [ "${COMMAND_GROUP}" = "AMAZON_LINUX_2023" ] &&
           [ -n "${AL2023_RELEASEVER}" ]; then
            run_step "DNF 저장소 사전 확인" \
                dnf --releasever="${AL2023_RELEASEVER}" -y makecache --refresh
            run_step "DNF 캐시 정리" dnf clean all
            run_step "DNF 메타데이터 재생성" \
                dnf --releasever="${AL2023_RELEASEVER}" -y makecache
            run_step "커널 업데이트" \
                dnf --releasever="${AL2023_RELEASEVER}" \
                -y upgrade "${KERNEL_PACKAGE}"
        else
            run_step "DNF 저장소 사전 확인" dnf -y makecache --refresh
            run_step "DNF 캐시 정리" dnf clean all
            run_step "DNF 메타데이터 재생성" dnf -y makecache
            run_step "커널 업데이트" dnf -y upgrade "${KERNEL_PACKAGE}"
        fi

        PATCH_EXECUTED=1
        ;;
esac

# ============================================================
# 7. Ubuntu 및 Debian
# ============================================================
case "${COMMAND_GROUP}" in
    UBUNTU_*|DEBIAN_*)
        check_command apt-get
        check_command apt-cache
        check_command dpkg
        check_command dpkg-query

        export DEBIAN_FRONTEND=noninteractive

        # 서비스 자동 재시작 금지, 필요한 서비스 목록만 표시
        export NEEDRESTART_MODE=l

        if dpkg --audit 2>/dev/null | grep . >/dev/null 2>&1; then
            fail "미완료 또는 비정상 DPKG 패키지 상태 확인"
        fi

        run_step "APT 저장소 사전 확인" apt-get update
        run_step "APT 패키지 캐시 정리" apt-get clean

        detect_apt_kernel_packages
        echo "[INFO] TARGET PACKAGE : ${APT_KERNEL_PACKAGES}"

        # dpkg-query로 확인된 패키지명만 전달
        # shellcheck disable=SC2086
        run_step "커널 업데이트" \
            apt-get install --only-upgrade -y ${APT_KERNEL_PACKAGES}

        PATCH_EXECUTED=1
        ;;
esac

# ============================================================
# 8. SLES 및 openSUSE
# ============================================================
case "${COMMAND_GROUP}" in
    SLES_*|OPENSUSE_LEAP_*|OPENSUSE_TUMBLEWEED)
        check_command zypper
        check_command rpm
        detect_rpm_kernel_package

        echo "[INFO] TARGET PACKAGE : ${KERNEL_PACKAGE}"

        run_zypper_step "Zypper 저장소 사전 확인" \
            zypper --non-interactive refresh
        run_zypper_step "Zypper 캐시 정리" \
            zypper --non-interactive clean --all
        run_zypper_step "Zypper 메타데이터 재생성" \
            zypper --non-interactive refresh
        run_zypper_step "커널 업데이트" \
            zypper --non-interactive update "${KERNEL_PACKAGE}"

        PATCH_EXECUTED=1
        ;;
esac

# ============================================================
# 9. 패치 결과 확인
# ============================================================
[ "${PATCH_EXECUTED}" -eq 1 ] ||
    fail "OS에 대응하는 커널 패치 명령이 실행되지 않음"

save_kernel_inventory "${KERNEL_AFTER_FILE}"
comm -13 "${KERNEL_BEFORE_FILE}" "${KERNEL_AFTER_FILE}" > "${KERNEL_NEW_FILE}"

if [ ! -s "${KERNEL_NEW_FILE}" ]; then
    echo "============================================================"
    echo "[SUCCESS] NO_UPDATE"
    echo "[SUCCESS] OS             : (${OS_ID} ${OS_VERSION})"
    echo "[SUCCESS] CURRENT KERNEL : ${CURRENT_KERNEL}"
    echo "[SUCCESS] REBOOT         : NOT_REQUIRED"
    echo "============================================================"

    cleanup
    trap - 0 1 2 15
    exit 0
fi

NEW_KERNELS="$(
    tr '\n' ' ' < "${KERNEL_NEW_FILE}" |
    sed 's/[[:space:]]*$//'
)"

[ -n "${NEW_KERNELS}" ] ||
    fail "신규 커널 버전 확인 실패"

# ============================================================
# 10. 자동 재부팅 예약
# ============================================================
check_command shutdown

echo "============================================================"
echo "[SUCCESS] KERNEL_UPDATE_COMPLETED"
echo "[SUCCESS] OS             : (${OS_ID} ${OS_VERSION})"
echo "[SUCCESS] OLD KERNEL     : ${CURRENT_KERNEL}"
echo "[SUCCESS] NEW KERNEL     : ${NEW_KERNELS}"
echo "============================================================"

run_step "재부팅 예약" \
    shutdown -r "+${REBOOT_DELAY_MINUTES}" \
    "Kernel update completed by AWS Systems Manager"

echo "============================================================"
echo "[SUCCESS] REBOOT_SCHEDULED"
echo "[SUCCESS] DELAY : ${REBOOT_DELAY_MINUTES} minute"
echo "============================================================"

cleanup
trap - 0 1 2 15
exit 0
