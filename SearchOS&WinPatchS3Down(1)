# =========================
# 분기별 수정 영역
# =========================
$bucket = "hdpm-lit"

$KB2016  = "KB5099535"
$Key2016 = "2026pm/02/windows/windows10.0-kb5099535-x64_272339725d88cf3a31a3ea9bf4e3e61ace5c2d91.msu"

$KB2019  = "KB5099538"
$Key2019 = "2026pm/02/windows10.0-kb5099538-x64_8ed669753c1d230738068aaac189c6457937dafb.msu"

$KB2022  = "KB5099540"
$Key2022 = "2026pm/02/windows10.0-kb5099540-x64_9238518dcf76e3b46d5c72e0392b0e04e5d2ae66.msu"

# =========================
# 공통 설정
# =========================
$TempDir = "C:\TempPM"
$local = Join-Path $TempDir "windows-update-file.msu"
$manifestPath = Join-Path $TempDir "patch-info.json"

$AwsCliMsiUrl = "https://awscli.amazonaws.com/AWSCLIV2.msi"
$AwsCliMsiPath = Join-Path $TempDir "AWSCLIV2.msi"
$AwsCliInstallTimeoutSec = 1800

function Stop-Script {
    param([int]$Code, [string]$Msg)
    Write-Output $Msg
    Write-Output ("RESULT_CODE : {0}" -f $Code)
    exit $Code
}

function Try-Remove-TempDir {
    param([string]$Reason = "CLEANUP")
    try {
        if (Test-Path $TempDir) {
            Remove-Item -Path $TempDir -Recurse -Force -ErrorAction Stop
            Write-Output "TEMP_DIR_REMOVED : $TempDir : reason=$Reason"
        } else {
            Write-Output "TEMP_DIR_NOT_FOUND : $TempDir : reason=$Reason"
        }
    } catch {
        Write-Output "TEMP_DIR_REMOVE_FAILED : $TempDir : reason=$Reason"
        Write-Output $_.Exception.Message
    }
}

function Test-KBInstalled {
    param([string]$KB)
    try {
        $hotFix = Get-HotFix -Id $KB -ErrorAction SilentlyContinue
        return ($null -ne $hotFix)
    } catch {
        Write-Output "KB_CHECK_WARNING : Get-HotFix query failed"
        Write-Output $_.Exception.Message
        return $false
    }
}

function Find-AwsCli {
    $awsCommand = Get-Command aws.exe -ErrorAction SilentlyContinue
    if ($awsCommand) {
        return $awsCommand.Source
    }

    $candidatePaths = @(
        "$env:ProgramFiles\Amazon\AWSCLIV2\aws.exe",
        "$env:ProgramFiles\Amazon\AWSCLI\bin\aws.exe"
    )

    if (${env:ProgramFiles(x86)}) {
        $candidatePaths += "${env:ProgramFiles(x86)}\Amazon\AWSCLI\bin\aws.exe"
    }

    foreach ($candidatePath in $candidatePaths) {
        if (Test-Path $candidatePath) {
            return $candidatePath
        }
    }

    return $null
}

function Ensure-AwsCli {
    $script:AwsExe = Find-AwsCli

    if ($script:AwsExe) {
        $awsVersion = & $script:AwsExe --version 2>&1
        Write-Output ("AWSCLI_FOUND : path={0} version={1}" -f $script:AwsExe, ($awsVersion -join " "))
        return
    }

    Write-Output "AWSCLI_NOT_FOUND"
    Write-Output "AWSCLI_INSTALL_START"

    if (-not [Environment]::Is64BitOperatingSystem) {
        Stop-Script -Code 40 -Msg "AWSCLI_INSTALL_FAILED : 64-bit Windows required"
    }

    try {
        New-Item -ItemType Directory -Force -Path $TempDir -ErrorAction Stop | Out-Null
        if (Test-Path $AwsCliMsiPath) {
            Remove-Item -Path $AwsCliMsiPath -Force -ErrorAction Stop
        }
    } catch {
        Write-Output $_.Exception.Message
        Stop-Script -Code 41 -Msg "AWSCLI_INSTALLER_PATH_PREPARE_FAILED"
    }

    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $AwsCliMsiUrl -OutFile $AwsCliMsiPath -UseBasicParsing -ErrorAction Stop
    } catch {
        Write-Output $_.Exception.Message
        Stop-Script -Code 42 -Msg "AWSCLI_INSTALLER_DOWNLOAD_FAILED"
    }

    if (-not (Test-Path $AwsCliMsiPath)) {
        Stop-Script -Code 43 -Msg "AWSCLI_INSTALLER_NOT_FOUND"
    }

    $awsCliInstallerInfo = Get-Item $AwsCliMsiPath

    if ($awsCliInstallerInfo.Length -le 0) {
        Stop-Script -Code 44 -Msg "AWSCLI_INSTALLER_FILE_INVALID"
    }

    try {
        $msiArguments = "/i `"$AwsCliMsiPath`" /qn /norestart"
        $msiProcess = Start-Process -FilePath "msiexec.exe" -ArgumentList $msiArguments -PassThru -ErrorAction Stop
    } catch {
        Write-Output $_.Exception.Message
        Stop-Script -Code 45 -Msg "AWSCLI_INSTALL_PROCESS_START_FAILED"
    }

    $installElapsed = 0

    while (-not $msiProcess.HasExited) {
        Start-Sleep -Seconds 5
        $installElapsed += 5
        $msiProcess.Refresh()

        if ($installElapsed -ge $AwsCliInstallTimeoutSec) {
            try {
                Stop-Process -Id $msiProcess.Id -Force -ErrorAction Stop
            } catch {
                Write-Output $_.Exception.Message
            }

            Stop-Script -Code 46 -Msg "AWSCLI_INSTALL_TIMEOUT"
        }
    }

    if ($msiProcess.ExitCode -ne 0 -and $msiProcess.ExitCode -ne 3010) {
        Stop-Script -Code 47 -Msg ("AWSCLI_INSTALL_FAILED : exitCode={0}" -f $msiProcess.ExitCode)
    }

    $script:AwsExe = Find-AwsCli

    if (-not $script:AwsExe) {
        Stop-Script -Code 48 -Msg "AWSCLI_INSTALL_FAILED : aws.exe not found after installation"
    }

    try {
        Remove-Item -Path $AwsCliMsiPath -Force -ErrorAction SilentlyContinue
    } catch {
    }

    $awsVersion = & $script:AwsExe --version 2>&1
    Write-Output ("AWSCLI_INSTALL_OK : path={0} version={1}" -f $script:AwsExe, ($awsVersion -join " "))
}

# =========================
# 0) OS 제품명 자동 판별
# =========================
try {
    $osInfo = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
    $osCaption = [string]$osInfo.Caption
    $osProductType = [int]$osInfo.ProductType
} catch {
    Write-Output $_.Exception.Message
    Stop-Script -Code 5 -Msg "OS_DETECTION_FAILED"
}

if ($osProductType -eq 1) {
    Stop-Script -Code 6 -Msg ("UNSUPPORTED_OS : Windows client OS detected : {0}" -f $osCaption)
}

switch -Wildcard ($osCaption) {
    "*Windows Server 2016*" {
        $osYear = "2016"
        $kb = $KB2016
        $key = $Key2016
        break
    }
    "*Windows Server 2019*" {
        $osYear = "2019"
        $kb = $KB2019
        $key = $Key2019
        break
    }
    "*Windows Server 2022*" {
        $osYear = "2022"
        $kb = $KB2022
        $key = $Key2022
        break
    }
    default {
        Stop-Script -Code 7 -Msg ("UNSUPPORTED_OS : caption={0}" -f $osCaption)
    }
}

$kbNorm = $kb.ToUpper()

Write-Output ("OS_DETECTED : year={0} caption={1}" -f $osYear, $osCaption)
Write-Output ("PATCH_SELECTED : kb={0} key={1}" -f $kbNorm, $key)

# =========================
# 1) 기존 설치 여부 확인
# =========================
if (Test-KBInstalled -KB $kbNorm) {
    Write-Output "PATCH_ALREADY_INSTALLED : $kbNorm"
    Write-Output "NO_ACTION : download/install/reboot skipped"
    Try-Remove-TempDir -Reason "ALREADY_INSTALLED"
    Stop-Script -Code 0 -Msg "DONE : ALREADY_INSTALLED"
}

# =========================
# 2) 작업 폴더 생성 및 이전 파일 제거
# =========================
try {
    New-Item -ItemType Directory -Force -Path $TempDir -ErrorAction Stop | Out-Null

    if (Test-Path $local) {
        Remove-Item -Path $local -Force -ErrorAction Stop
        Write-Output "OLD_PATCH_FILE_REMOVED"
    }

    if (Test-Path $manifestPath) {
        Remove-Item -Path $manifestPath -Force -ErrorAction Stop
        Write-Output "OLD_PATCH_MANIFEST_REMOVED"
    }
} catch {
    Write-Output $_.Exception.Message
    Stop-Script -Code 8 -Msg "TEMP_FILE_PREPARE_FAILED"
}

# =========================
# 3) AWS CLI 확인 및 자동 설치
# =========================
Ensure-AwsCli

# =========================
# 4) AWS 자격 증명 확인
# =========================
try {
    $identity = & $script:AwsExe sts get-caller-identity --output json 2>$null

    if ($LASTEXITCODE -ne 0 -or -not $identity) {
        Stop-Script -Code 11 -Msg "STS_CALLER_CHECK_FAILED : credentials / IAM role 확인 필요"
    }

    Write-Output "STS_CALLER_OK"
} catch {
    Write-Output $_.Exception.Message
    Stop-Script -Code 12 -Msg "STS_CALLER_EXCEPTION : credentials / IAM role 확인 필요"
}

# =========================
# 5) S3 다운로드
# =========================
Write-Output "S3_DOWNLOAD_START"
Write-Output ("S3_SOURCE : s3://{0}/{1}" -f $bucket, $key)
Write-Output ("LOCAL_TARGET : {0}" -f $local)

& $script:AwsExe s3 cp "s3://$bucket/$key" "$local" --no-progress
$awsExitCode = $LASTEXITCODE

if ($awsExitCode -ne 0) {
    Stop-Script -Code 20 -Msg ("S3_DOWNLOAD_FAILED : awsExitCode={0}" -f $awsExitCode)
}

if (-not (Test-Path $local)) {
    Stop-Script -Code 21 -Msg "S3_DOWNLOAD_FAILED : local file not found"
}

$fileInfo = Get-Item $local

if ($fileInfo.Length -le 0) {
    Stop-Script -Code 22 -Msg "S3_DOWNLOAD_FAILED : downloaded file size is zero"
}

# =========================
# 6) 다운로드 파일 검증 정보 저장
# =========================
try {
    $fileHash = Get-FileHash -Path $local -Algorithm SHA256 -ErrorAction Stop

    $manifest = [PSCustomObject]@{
        OSYear      = $osYear
        OSCaption   = $osCaption
        KB          = $kbNorm
        S3Bucket    = $bucket
        S3Key       = $key
        LocalPath   = $local
        SizeBytes   = $fileInfo.Length
        SHA256      = $fileHash.Hash
        DownloadedAt = (Get-Date).ToString("o")
    }

    $manifest | ConvertTo-Json | Set-Content -Path $manifestPath -Encoding UTF8 -ErrorAction Stop
} catch {
    Write-Output $_.Exception.Message
    Stop-Script -Code 23 -Msg "PATCH_MANIFEST_CREATE_FAILED"
}

Write-Output "S3_DOWNLOAD_OK"
Write-Output ("DOWNLOADED_FILE : path={0} size={1}" -f $fileInfo.FullName, $fileInfo.Length)
Write-Output ("DOWNLOADED_SHA256 : {0}" -f $fileHash.Hash)
Write-Output ("PATCH_MANIFEST_CREATED : {0}" -f $manifestPath)

Stop-Script -Code 0 -Msg "DONE : DOWNLOAD_COMPLETED"
